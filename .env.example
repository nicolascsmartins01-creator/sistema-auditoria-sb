# Copie para .env.local e preencha com os dados do projeto Supabase
# (Supabase → Project Settings → API). NUNCA envie .env.local ao GitHub.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-publica-anon-ou-publishable
# Chave secreta: usada SOMENTE no servidor (criar usuários, bloquear login).
SUPABASE_SERVICE_ROLE_KEY=chave-secreta-service-role
# Segredo do agendamento diário de fechamento (Vercel → Settings → Environment Variables).
# Qualquer texto longo e aleatório; a Vercel o envia automaticamente ao rodar o agendamento.
CRON_SECRET=um-texto-longo-e-aleatorio
